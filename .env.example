# DEADMAN environment configuration
# -----------------------------------
# MOCK MODE (default): none of these are required.
#   python scripts/run_demo.py     — runs on the stdlib, zero config.
#   uvicorn deadman.webhook:app    — server in mock mode, demo endpoints work.
#
# REAL MODE: set DEADMAN_MODE=real and fill in the keys below, then:
#   uvicorn deadman.webhook:app --port 8080
# ============================================================

# ── Mode ────────────────────────────────────────────────────
# "mock" (default) or "real"
DEADMAN_MODE=mock

# ── Webhook security (optional) ───────────────────────────────
# When set, POST /incident requires authentication via EITHER:
#   * Authorization: Bearer <DEADMAN_WEBHOOK_SECRET>, OR
#   * X-Deadman-Signature: hex HMAC-SHA256 of the raw request body keyed by the
#     secret (PagerDuty / CloudWatch sign payloads this way; a "sha256=" prefix
#     is tolerated). Mismatch -> 401.
# UNSET (the default) leaves /incident open — fine for mock/dev + the demo.
# STRONGLY recommended in any real (DEADMAN_MODE=real) deployment, since
# /incident can drive destructive tools.
DEADMAN_WEBHOOK_SECRET=

# ── Demo / chaos endpoints toggle ─────────────────────────────
# Unset/default is mode-aware: enabled in mock mode, disabled in real mode.
# Set "1" only for the stage demo. Set "0" explicitly in production.
DEADMAN_ENABLE_DEMO=

# ── TrueFoundry AI Gateway ────────────────────────────────────
# API key from the TrueFoundry dashboard.
TFY_API_KEY=

# Base URL of the TrueFoundry AI Gateway (OpenAI-compatible endpoint).
# Example: https://<workspace>.truefoundry.cloud/api/llm/openai
TFY_GATEWAY_BASE_URL=

# Name of the virtual/resilient model configured in the AI Gateway dashboard.
# This is the model whose fallback chain is declared in infra/ai_gateway.yaml.
TFY_RESILIENT_MODEL=deadman-resilient-bedrock

# Freeform metadata attached to every AI Gateway request for tracing.
TFY_METADATA=app=deadman,role=incident-commander

# ── TrueFoundry MCP Gateway ───────────────────────────────────
# URL of the TrueFoundry MCP Gateway (Agent Gateway / MCP proxy).
# Example: https://<workspace>.truefoundry.cloud/mcp
TFY_MCP_GATEWAY_URL=

# ── AWS / Bedrock ─────────────────────────────────────────────
# Standard AWS credentials used for Bedrock model calls and (optionally)
# DynamoDB state storage. Leave blank to use instance-profile / IAM roles.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_FALLBACK_REGION=us-west-2

# ── State backend ─────────────────────────────────────────────
# "file"     (default) — stores state in .deadman_state/ on disk.
# "dynamodb" — production-grade; requires AWS creds above.
DEADMAN_STATE_BACKEND=file

# DynamoDB table name (only used when DEADMAN_STATE_BACKEND=dynamodb).
# The table must be pre-created; see docs for the required schema.
DEADMAN_DYNAMODB_TABLE=deadman-incident-state

# ── Rate limiting ─────────────────────────────────────────────
# Token-bucket rate limiter for POST /incident, keyed by client IP.
# Default 0 = disabled (safe for tests and mock/dev). Set to e.g. 10 in production.
# DEADMAN_RATE_LIMIT_RPS=0

# Burst capacity (max tokens in the bucket). When unset, defaults to 2×RPS (min 1).
# Has no effect when DEADMAN_RATE_LIMIT_RPS=0.
# DEADMAN_RATE_LIMIT_BURST=20

# ── Graceful shutdown ─────────────────────────────────────────
# Seconds to wait for in-flight /incident handlers to drain before the process exits.
# DEADMAN_DRAIN_TIMEOUT_SECONDS=10

# ── State TTL & directory ─────────────────────────────────────
# DynamoDB TTL retention in seconds (default 2592000 = 30 days).
# Set to 0 to disable TTL writes entirely (opt-in).
# Only used when DEADMAN_STATE_BACKEND=dynamodb.
# DEADMAN_STATE_TTL_SECONDS=2592000

# Directory for the file-based state backend.
# Only used when DEADMAN_STATE_BACKEND=file (the default).
# DEADMAN_STATE_DIR=.deadman_state

# ── Threshold overrides ───────────────────────────────────────
# p99 latency budget in ms; exceeding this sheds to the next AI tier.
# DEADMAN_P99_BUDGET_MS=1500

# Fallback depth at which destructive authority is auto-revoked.
# DEADMAN_REVOKE_AT_DEPTH=2

# Minimum replica floor — Pre-Tool guardrail blocks asg.scale below this.
# DEADMAN_MIN_REPLICA_FLOOR=2

# ── OpenTelemetry ─────────────────────────────────────────────
# When set, spans are exported via OTLP (Grafana / Datadog / Splunk / Jaeger).
# Leave blank to disable OTel entirely (default for mock mode).
# The MCP audit log is the OTel export described in infra/guardrails.yaml.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=deadman-incident-commander
